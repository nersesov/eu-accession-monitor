# Скопіюйте у .env (на сервері: chmod 600 .env). Файл .env не потрапляє в git.

# --- PostgreSQL ---
POSTGRES_USER=reform
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=reform_monitor

# --- Застосунок ---
# Довгий випадковий рядок: openssl rand -hex 32
PAYLOAD_SECRET=change-me-openssl-rand-hex-32
# Публічна адреса сайту БЕЗ слеша в кінці. Має точно збігатися з адресою в браузері:
# використовується для canonical/hreflang/sitemap і для CSRF-перевірки входу в адмінку.
# На VPS: https://reform-monitor.<IP>.sslip.io
SITE_URL=http://localhost:3000
APP_PORT=3000
# Інтерфейс, на якому публікується порт. 127.0.0.1 — лише через зворотний проксі; 0.0.0.0 — напряму назовні.
APP_BIND=127.0.0.1
# Образ застосунку. Локально збирається з Dockerfile; на VPS — тег із GHCR.
APP_IMAGE=reform-monitor:local

# Перший адміністратор створюється при першому старті, якщо користувачів ще немає
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Наповнити порожню базу демонстраційними даними при старті (true/false)
SEED_ON_START=true

# --- Імпорт із Google Sheets ---
# ID публічної таблиці (частина URL між /d/ та /edit). Порожньо = локальні CSV з data/sheets
GOOGLE_SHEET_ID=
# Щоденна синхронізація за розкладом (Payload Jobs)
ENABLE_JOBS=true

# --- Лише для профілю prod (Caddy) ---
DOMAIN=reform-monitor.203.0.113.10.sslip.io
ACME_EMAIL=admin@example.com

REPO_URL=https://github.com/nersesov/eu-accession-monitor
